<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- Pearl tile surface fills the whole canvas, so any launcher mask (circle, squircle) shows only the tile. -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="0" android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#F3F4DF"/>
                <item android:offset="1" android:color="#C3CFBC"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
