# /etc/insight-ops/watch.env — root, mode 600. Sourced by insight-watch.sh.
#
# Create the bot with @BotFather in Telegram: /newbot, then send the bot any
# message so it has a chat to answer in. The chat id appears in
# https://api.telegram.org/bot<token>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Checks and thresholds. Defaults match this host; override only if it moves.
# HEALTH_URL=http://127.0.0.1:3000/health
# PUBLIC_URL=https://13.140.89.146/health
# APK_URL=https://13.140.89.146/INSIGHT-online.apk
# BACKUP_DIR=/opt/insight-online/backups
# BACKUP_HOURS=27
# DISK_LIMIT=80
# MEMORY_FLOOR_MB=250
# CERT_DAYS=3
# HTTP5XX_LIMIT=5
# DRILL_HOURS=840
# SERVICES="insight-online nginx postgresql@16-main"
# TIMERS="insight-backup.timer insight-certificate.timer"
