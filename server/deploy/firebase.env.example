# /etc/insight-ops/firebase.env — root, mode 600. Sourced by distribute-apk.sh.
# The App ID is under Firebase console → Project settings → Your apps.
FIREBASE_APP_ID=1:000000000000:android:0000000000000000000000
FIREBASE_GROUPS=testers
GOOGLE_APPLICATION_CREDENTIALS=/etc/insight-ops/firebase-sa.json
