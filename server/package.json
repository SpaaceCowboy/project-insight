    "test:integration": "node --import tsx --test test/*.integration.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
