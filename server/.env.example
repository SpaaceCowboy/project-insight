# Copy to .env at the repository root for Docker Compose. Never commit the real file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
ENCRYPTION_KEY=replace-with-64-random-hex-characters
DATABASE_URL=postgresql://insight:replace-with-a-long-random-password@127.0.0.1:5432/insight
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Production requires a dedicated private Redis with AOF and maxmemory-policy=noeviction.
# Native VPS: unix:///run/insight-rate-limit/redis.sock. Compose uses a private service URL.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_NAMESPACE=insight:rate:v1
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=Midori <accounts@localhost>
# The Web OAuth client ID from Google Cloud. The app's -PinsightGoogleClientId must match it.
GOOGLE_CLIENT_ID=
# Share feedback and Report a bug are mailed here.
FEEDBACK_TO=Insight.correspondence@gmail.com
# Keep reports on the server; switch to smtp only after configuring and testing outgoing email.
FEEDBACK_DELIVERY_MODE=store
# smtp: send reset codes; test-inbox: send to Mailpit; disabled: password reset is unavailable.
MAIL_DELIVERY_MODE=test-inbox
# Production SMTP only:
# SMTP_USER=
# SMTP_PASSWORD=
# TRUST_PROXY=172.16.0.0/12
# Comma-separated account IDs exempt from the daily puzzle limit (development accounts only).
# DEVELOPER_USER_IDS=
